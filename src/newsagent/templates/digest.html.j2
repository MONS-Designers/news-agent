<!doctype html>
<html dir="rtl" lang="he">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>הדייג'סט היומי שלך</title>
<link href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;600;700;800;900&family=Gveret+Levin&display=swap" rel="stylesheet">
</head>
<body style="margin:0; padding:0; background-color:#1c2333;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#1c2333; padding:32px 0;">
<tr><td align="center">
<table role="presentation" width="600" cellpadding="0" cellspacing="0" style="background-color:#0b1020; border-radius:16px; overflow:hidden; max-width:600px; width:100%;">

<!-- Masthead -->
<tr><td style="padding:32px 32px 24px; border-bottom:1px solid rgba(240,180,41,.22);">
  <div style="font-family:'Rubik','Segoe UI',Arial,sans-serif; font-size:11px; font-weight:700; letter-spacing:5px; text-transform:uppercase; color:#f0b429;">תדרוך יומי</div>
  <h1 style="font-family:'Rubik','Segoe UI',Arial,sans-serif; font-size:36px; font-weight:900; color:#ffffff; margin:10px 0 6px; letter-spacing:-0.5px; line-height:1.1;">חדשות הבוקר</h1>
  <div style="font-family:'Rubik','Segoe UI',Arial,sans-serif; font-size:12.5px; color:#a3adc4; letter-spacing:.3px;">{{ digest_date }} &nbsp;·&nbsp; {{ total_reading_time }} דקות קריאה</div>
</td></tr>

{% if intro_he %}
<tr><td style="padding:24px 32px 0;">
  <div style="font-family:'Rubik','Segoe UI',Arial,sans-serif; font-size:18px; font-weight:500; line-height:1.7; color:#d7deef;">{{ intro_he }}</div>
</td></tr>
{% endif %}

<!-- 30-second scan -->
<tr><td style="padding:20px 32px 4px;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:rgba(240,180,41,.055); border:1px solid rgba(240,180,41,.28); border-radius:12px;">
    <tr><td style="padding:18px 22px;">
      <h2 style="font-family:'Rubik','Segoe UI',Arial,sans-serif; font-size:11px; font-weight:700; letter-spacing:2px; text-transform:uppercase; color:#f0b429; margin:0 0 12px;">◆ 30 שניות · על קצה המזלג</h2>
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
        {% for article in articles %}
        <tr><td style="padding:5px 0; font-family:'Rubik','Segoe UI',Arial,sans-serif; font-size:14.5px; color:#dbe2f2; line-height:1.5; border-bottom:1px solid rgba(255,255,255,.05);">
          <span style="color:{{ article.topic_color }};">●</span> {{ article.title_he }}
        </td></tr>
        {% endfor %}
      </table>
    </td></tr>
  </table>
</td></tr>

<!-- Articles -->
{% for article in articles %}
{% if not loop.first %}
<tr><td style="padding:0 32px;"><div style="height:1px; background:linear-gradient(90deg,transparent,rgba(240,180,41,.3),transparent);"></div></td></tr>
{% endif %}
<tr><td style="padding:24px 32px 10px;">
  <span style="display:inline-block; font-family:'Rubik','Segoe UI',Arial,sans-serif; font-size:10px; font-weight:700; letter-spacing:1.5px; text-transform:uppercase; color:{{ article.topic_color }}; padding:5px 13px; border-radius:20px; border:1px solid {{ article.topic_color }};">{{ article.topic_label }}</span>
  <h2 style="font-family:'Rubik','Segoe UI',Arial,sans-serif; font-size:24px; font-weight:800; color:#ffffff; line-height:1.35; margin:14px 0 12px; letter-spacing:-.2px;">{{ article.title_he }}</h2>
  <ul style="list-style:none; margin:0; padding:0; font-family:'Rubik','Segoe UI',Arial,sans-serif;">
    {% for bullet in article.bullets %}
    <li style="font-size:15px; color:#cfd7e8; line-height:1.7; padding:4px 0 4px 20px; position:relative;">
      <span style="position:absolute; right:0; color:#f0b429;">—</span>{{ bullet }}
    </li>
    {% endfor %}
  </ul>
  <div style="font-family:'Rubik','Segoe UI',Arial,sans-serif; font-size:12px; color:#7a85a0; margin-top:14px; padding-top:11px; border-top:1px solid rgba(255,255,255,.07);">
    <bdi>{{ article.source_name }}</bdi> &nbsp;·&nbsp; {{ article.reading_time_minutes }} דק׳ קריאה &nbsp;·&nbsp;
    <a href="{{ article.url }}" style="color:#f0b429; text-decoration:none;">למקור באנגלית ←</a>
  </div>
</td></tr>
{% endfor %}

{% if dad_joke_he %}
<!-- קינוח: magic-8-ball fortune -->
<tr><td style="padding:28px 32px 22px;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border:1px solid rgba(240,180,41,.4); border-radius:18px; background-color:#141b32;">
    <tr><td style="padding:30px 24px 28px; text-align:center;">
      <div style="font-family:'Rubik','Segoe UI',Arial,sans-serif; font-size:11px; font-weight:700; letter-spacing:3px; text-transform:uppercase; color:#f0b429;">✨ {{ joke_corner_title }} · הכדור הקסום של החדשות</div>
      <div style="width:74px; height:74px; margin:18px auto 16px; border-radius:50%; background-color:#d99a1c; font-size:30px; line-height:74px;">🔮</div>
      <div style="font-family:'Gveret Levin','Rubik','Segoe UI',cursive,sans-serif; font-size:26px; line-height:1.55; color:#fde9c7; max-width:430px; margin:0 auto;">{{ dad_joke_he }}</div>
    </td></tr>
  </table>
</td></tr>
{% endif %}

<!-- Footer -->
<tr><td style="padding:22px 32px; border-top:1px solid rgba(255,255,255,.07);">
  <div style="font-family:'Rubik','Segoe UI',Arial,sans-serif; font-size:12px; color:#a3adc4; line-height:1.6;">
    שלחתי לך את זה כי ביקשת שאשמור לך על הדופק. משהו לא מדויק?
    <a href="{{ preferences_url }}" style="color:#a3adc4;">בוא נכוונן יחד ←</a>
  </div>
</td></tr>

</table>
<img src="{{ tracking_pixel_url }}" width="1" height="1" alt="" style="display:block;">
</td></tr>
</table>
</body>
</html>

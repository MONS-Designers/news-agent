# Copy to .env and fill in real values. Never commit .env.

# SQLAlchemy database URL — Postgres (e.g. a Neon branch). No usable default;
# must be set for the app to connect to anything.
# NEWSAGENT_DATABASE_URL=postgresql+psycopg://user:password@host/dbname

# LLM provider adapter: "mock" (default, offline) or "external" (real API, articles)
# NEWSAGENT_LLM_PROVIDER=mock

# Articles scoring at or above this are kept for the digest (0.0-1.0)
# NEWSAGENT_RELEVANCE_THRESHOLD=0.7

# Suggestion Source adapter: "popularity" (default, offline) or "llm" (real API, profile suggestions)
# NEWSAGENT_SUGGESTION_PROVIDER=popularity

# Self-registration hard cap — total User rows allowed, admin-seeded or self-registered (FR2)
# NEWSAGENT_MAX_USERS=10

# External LLM (used when NEWSAGENT_LLM_PROVIDER=external) — unprefixed, real
# article scoring/summarizing. OpenAI-compatible chat-completions endpoint.
# EXTERNAL_LLM_BASE_URL=
# EXTERNAL_LLM_AUTH_TOKEN=
# EXTERNAL_LLM_MODEL=

# Local LLM (used when NEWSAGENT_SUGGESTION_PROVIDER=llm) — unprefixed, real
# profile-suggestion generation, independent of EXTERNAL_LLM_* (AD-3).
# LOCAL_LLM_BASE_URL=
# LOCAL_LLM_AUTH_TOKEN=
# LOCAL_LLM_MODEL=

# Email sender adapter: "console" (default, prints to stdout) or "smtp" (real delivery)
# NEWSAGENT_EMAIL_SENDER=console
# Optional: directory where the console sender also writes each email's HTML
# NEWSAGENT_EMAIL_OUTBOX_DIR=./outbox

# SMTP sender (used when NEWSAGENT_EMAIL_SENDER=smtp) — plain stdlib smtplib,
# no vendor SDK, works with any real SMTP account.
# For Gmail: host=smtp.gmail.com, port=587, tls=true, username=your full
# Gmail address. The password must be a 16-character Google "App Password"
# (myaccount.google.com/apppasswords, requires 2-Step Verification enabled)
# — your normal Gmail password will not work over SMTP.
# NEWSAGENT_SMTP_HOST=smtp.gmail.com
# NEWSAGENT_SMTP_PORT=587
# NEWSAGENT_SMTP_USERNAME=
# NEWSAGENT_SMTP_PASSWORD=
# NEWSAGENT_SMTP_FROM_ADDRESS=
# NEWSAGENT_SMTP_USE_TLS=true

# Google OAuth client (create at https://console.cloud.google.com/apis/credentials,
# type "Web application", authorized redirect URI: http://127.0.0.1:8000/auth/callback)
NEWSAGENT_GOOGLE_CLIENT_ID=
NEWSAGENT_GOOGLE_CLIENT_SECRET=

# Secret used to sign the session cookie — set a long random value outside local dev
NEWSAGENT_SESSION_SECRET=

# Where the API redirects after login (Vue dev server)
# NEWSAGENT_FRONTEND_URL=http://127.0.0.1:5173

# Packages news-agent's Vue SPA as a runnable static-serving image. Lives at
# the repo root of news-agent, builds from local context.
#
# Two stages: `build` (Node 20) produces the production dist/; `serve`
# (nginx, non-root via nginxinc/nginx-unprivileged) is the only stage that
# ships. SPA fallback matches news-agent-infra's deploy/nginx.conf app.*
# server block.

# --- Stage 1: build ---
FROM node:20-slim AS build

ARG VITE_API_BASE
RUN test -n "$VITE_API_BASE" || { \
      echo "VITE_API_BASE build arg is required (no default) -- e.g. --build-arg VITE_API_BASE=https://api.newsagent-ai.com" >&2; \
      exit 1; \
    }

WORKDIR /src/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ .
RUN npm run build

# --- Stage 2: serve -- only stage that ships ---
FROM nginxinc/nginx-unprivileged:1.27-alpine AS serve

COPY --from=build /src/frontend/dist /usr/share/nginx/html
COPY nginx.frontend.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["wget", "-q", "-O", "/dev/null", "http://localhost:8080/"]

# Packages news-agent's Vue SPA as a runnable static-serving image. Lives at
# the repo root of news-agent, builds from local context.
#
# Two stages: `build` (Node 20) produces the production dist/; `serve`
# (nginx, non-root via nginxinc/nginx-unprivileged) is the only stage that
# ships.
#
# No VITE_API_BASE build arg: client.ts already falls back to the relative
# path "/api" when it's unset, matching frontend/vite.config.ts's own dev
# proxy (which rewrites /api -> the backend, stripping the prefix). Baking an
# absolute URL in here would freeze one environment's backend hostname into
# the image, breaking the stage->prod promotion this image is built for.
# nginx.frontend.conf.template does the same /api proxying at runtime
# instead, via one BACKEND_HOST env var set per environment.

# --- Stage 1: build ---
FROM node:20-slim AS build

WORKDIR /src/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ .
RUN npm run build

# CAP-5 (spec-gitops-deploy-trigger): a static version.json, same shape as
# the backend's /health commit field, so a deploy/rollback can be verified
# against what's actually running rather than trusting a green build (both
# environments track a fixed, reused ACR tag). Written into dist/ here (this
# stage runs as root, no permission questions) so the single COPY below picks
# it up like any other build asset -- no separate copy step, no nginx config
# change needed. Defaults to "unknown" for any build that doesn't pass it.
ARG GIT_SHA=unknown
RUN echo "{\"commit\": \"$GIT_SHA\"}" > dist/version.json

# --- Stage 2: serve -- only stage that ships ---
FROM nginxinc/nginx-unprivileged:1.27-alpine AS serve

COPY --from=build /src/frontend/dist /usr/share/nginx/html
# nginx-unprivileged ships the same 20-envsubst-on-templates.sh entrypoint as
# upstream nginx: any *.template file here is envsubst'd into conf.d on
# container start, substituting $BACKEND_HOST from the environment.
COPY nginx.frontend.conf.template /etc/nginx/templates/default.conf.template

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["wget", "-q", "-O", "/dev/null", "http://localhost:8080/"]
